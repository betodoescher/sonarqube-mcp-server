# SonarQube server URL (required) - e.g. http://localhost:9000
SONARQUBE_URL=http://localhost:9000

# SonarQube authentication token (required)
# Generate at: SonarQube > My Account > Security > Generate Tokens
# Minimum permissions: Browse on all projects, Execute Analysis
SONARQUBE_TOKEN=your_sonarqube_token_here

# Scanner timeout in milliseconds (optional, default: 120000 = 2 minutes)
SONAR_SCAN_TIMEOUT_MS=120000

# Task polling interval in milliseconds (optional, default: 3000 = 3 seconds)
SONAR_TASK_POLL_INTERVAL_MS=3000

# Cyclomatic complexity threshold for get_complexity tool (optional, default: 15)
SONAR_COMPLEXITY_THRESHOLD=15

# Minimum coverage percentage for coverage checks (optional, default: 80)
SONAR_COVERAGE_MIN=80
